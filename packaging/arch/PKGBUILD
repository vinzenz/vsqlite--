pkgname=vsqlitepp
pkgver=0.4.2
pkgrel=1
pkgdesc='Portable SQLite3 wrapper for C++20'
arch=('x86_64')
url='https://github.com/vinzenz/vsqlite--'
license=('BSD-3-Clause')
depends=('sqlite')
makedepends=('cmake' 'gcc' 'ninja')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cmake -S "${srcdir}/${pkgname}-${pkgver}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_SHARED_LIBS=ON \
    -DVSQLITE_BUILD_EXAMPLES=OFF \
    -DVSQLITE_BUILD_TESTS=OFF \
    -DVSQLITE_BUNDLED_SQLITE=OFF
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
}
