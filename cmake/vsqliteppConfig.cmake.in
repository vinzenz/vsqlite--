@PACKAGE_INIT@

set(VSQLITEPP_BUNDLED_SQLITE @VSQLITE_BUNDLED_SQLITE@)
if(NOT VSQLITEPP_BUNDLED_SQLITE)
  # The exported targets link the SQLite target by name. Re-resolve the
  # dependency in the consumer's environment (instead of a build-machine
  # path recorded at install time) before loading them.
  include(CMakeFindDependencyMacro)
  find_dependency(SQLite3)
  # Newer CMake releases only provide SQLite3::SQLite3 while older ones only
  # provide the deprecated SQLite::SQLite3 spelling. Make both names resolve
  # so the exported targets load regardless of which CMake produced them.
  if(TARGET SQLite::SQLite3 AND NOT TARGET SQLite3::SQLite3)
    add_library(SQLite3::SQLite3 ALIAS SQLite::SQLite3)
  elseif(TARGET SQLite3::SQLite3 AND NOT TARGET SQLite::SQLite3)
    add_library(SQLite::SQLite3 ALIAS SQLite3::SQLite3)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/vsqliteppTargets.cmake")

check_required_components(vsqlitepp)
